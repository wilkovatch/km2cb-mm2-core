{
	"geometryless": true,
	"defaultCurveType": 0,
	"segments": 10,
	"segmentsPer100m": false,
	"hermiteTension": 0.5,
	"subdivideEqually": false,
	"project": true,
	"projectAll": false,
	"lpf": 0,
	"adjustLowPolyWidth": false,
	"variableSections": false,
	"rollRequires": "assumeMM2Hook",
	"sectionVertices": [
		"-0.5*totalWidthI",
		"-0.5*roadWidthT",
		"-0.5*trueDivWidth",
		"0",
		"0.5*trueDivWidth",
		"0.5*roadWidthT",
		"0.5*totalWidthI"
	],
	"propsContainers": [
		"rightParking",
		"leftParking"
	],
	"propsLines": [
		{
			"containerName": "rightParking",
			"condition": "forwardPark and forwardParkWidth > 0",
			"bounds": [
				"v1-h+localRight*realFwParkW",
				"v1-h"
			]
		},
		{
			"containerName": "leftParking",
			"condition": "backwardPark and backwardParkWidth > 0",
			"bounds": [
				"v5-h-localRight*realBwParkW",
				"v5-h"
			]
		}
	],
	"trafficTypes": [
		{
			"name": "pedestrian",
			"color": [
				224,
				32,
				224
			]
		},
		{
			"name": "forward",
			"color": [
				0,
				128,
				255
			]
		},
		{
			"name": "backward",
			"color": [
				224,
				32,
				0
			]
		},
		{
			"name": "cableCarForward",
			"color": [
				255,
				192,
				0
			]
		},
		{
			"name": "cableCarBackward",
			"color": [
				255,
				128,
				0
			]
		}
	],
	"textures": [],
	"widths": [
		"totalWidth",
		"roadWidth",
		"dividerWidth",
		"backwardParkWidth",
		"forwardParkWidth",
		"backwardLanesSpace",
		"forwardLanesSpace"
	],
	"getters": {
		"totalWidth": "totalWidthI",
		"roadWidth": "roadWidthT",
		"height": "hVal",
		"canBeSimplified": "canBeSimplified",
		"hasSidewalks": "hasRealSidewalks"
	},
	"components": [
		{
			"name": "pedestrians_right",
			"condition": "hasRealSidewalks"
		},
		{
			"name": "lanes",
			"condition": "not hasRealDivider"
		},
		{
			"name": "lanes_divided",
			"condition": "hasRealDivider"
		},
		{
			"name": "pedestrians_left",
			"condition": "hasRealSidewalks"
		}
	]
}
