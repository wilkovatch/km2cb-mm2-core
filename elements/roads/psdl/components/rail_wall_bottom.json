{
	"localDefinitions": [
		{
			"name": "wallL",
			"type": "bool",
			"value": "rail_typeI = 2 and rail_hasLeft"
		},
		{
			"name": "wallR",
			"type": "bool",
			"value": "rail_typeI = 2 and rail_hasRight"
		},
		{
			"name": "right",
			"type": "vec3",
			"value": "localRight*rail_height/3"
		},
		{
			"name": "offL_start",
			"type": "vec3",
			"value": "if(rail_offsetStartLeft, localForward * 2, vec3(0,0,0))"
		},
		{
			"name": "offL_end",
			"type": "vec3",
			"value": "if(rail_offsetEndLeft, -localForward * 2, vec3(0,0,0))"
		},
		{
			"name": "offR_start",
			"type": "vec3",
			"value": "if(rail_offsetStartRight, localForward * 2, vec3(0,0,0))"
		},
		{
			"name": "offR_end",
			"type": "vec3",
			"value": "if(rail_offsetEndRight, -localForward * 2, vec3(0,0,0))"
		},
		{
			"name": "offL",
			"type": "vec3",
			"value": "if(segment=1, offL_start, if(segment=segments, offL_end, vec3(0,0,0)))"
		},
		{
			"name": "offR",
			"type": "vec3",
			"value": "if(segment=1, offR_start, if(segment=segments, offR_end, vec3(0,0,0)))"
		},
		{
			"name": "rRight",
			"type": "vec3",
			"value": "if(wallR, -right+offR, vec3(0,0,0))"
		},
		{
			"name": "lRight",
			"type": "vec3",
			"value": "if(wallL, right+offL, vec3(0,0,0))"
		}
	],
	"mainMesh": {
		"vertices": [
			"v6+lRight-localUp-if(wallL, offL, vec3(0,0,0))",
			"v0+rRight-localUp-if(wallR, offR, vec3(0,0,0))",
		],
		"uvs": [
			"vec2(rlPos, 1)",
			"vec2(rlPos, 0)"
		],
		"faces": [
			0
		],
		"facesTextures": [
			0
		]
	}
}